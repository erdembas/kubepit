{
  "name": "kubepit",
  "private": true,
  "version": "0.0.6",
  "description": "A local-first Kubernetes IDE for many clusters.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm tauri:dev",
    "dev:ui": "pnpm --filter @kubepit/desktop dev",
    "dev:site": "pnpm --filter @kubepit/website dev",
    "build:site": "pnpm --filter @kubepit/website build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/site/preview.mjs",
    "build": "pnpm --filter @kubepit/desktop build",
    "tauri:dev": "pnpm --filter @kubepit/desktop tauri:dev",
    "tauri:build": "pnpm --filter @kubepit/desktop tauri:build",
    "tauri:build:local": "pnpm --filter @kubepit/desktop tauri:build:local",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:ui": "pnpm --filter @kubepit/desktop test",
    "test:site": "node --test scripts/site/*.test.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "changelog:sync": "node scripts/changelog/sync.mjs",
    "changelog:check": "node scripts/changelog/sync.mjs --check",
    "test:changelog": "node --test scripts/changelog/*.test.mjs",
    "sync:releases": "node scripts/site/sync-releases.mjs",
    "check:version": "node scripts/check-version.mjs",
    "perf:bench": "pnpm --filter @kubepit/desktop bench --outputJson ../../perf-results/frontend-bench.json",
    "perf:ui": "node scripts/perf/ui-perf.mjs",
    "perf:rust": "cargo bench -p kubepit-core -- --noplot",
    "perf:compare": "node scripts/perf/compare.mjs",
    "perf:test": "node --test scripts/perf/"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2"
  }
}
